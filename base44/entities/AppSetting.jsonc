{
  "title": "AppSetting",
  "type": "object",
  "properties": {
    "currency": {
      "type": "string"
    },
    "reminder_window_days": {
      "type": "number"
    },
    "reminder_offsets": {
      "type": "string"
    },
    "email_reminders_enabled": {
      "type": "boolean"
    },
    "monthly_target": {
      "type": "number"
    },
    "digest_enabled": {
      "type": "boolean"
    },
    "timezone": {
      "type": "string"
    },
    "locale": {
      "type": "string"
    },
    "theme": {
      "type": "string",
      "enum": [
        "light",
        "dark",
        "system"
      ]
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  },
  "name": "AppSetting",
  "required": []
}