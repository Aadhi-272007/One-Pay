{
  "title": "Subscription",
  "type": "object",
  "properties": {
    "plan_name": {
      "type": "string"
    },
    "merchant": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string"
    },
    "billing_interval": {
      "type": "string",
      "enum": [
        "weekly",
        "monthly",
        "quarterly",
        "annual"
      ]
    },
    "next_renewal_date": {
      "type": "string"
    },
    "trial_end_date": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "cancelled",
        "expired"
      ]
    },
    "autopay": {
      "type": "boolean"
    },
    "upi_id": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "gmail_message_id": {
      "type": "string"
    },
    "calendar_status": {
      "type": "string",
      "enum": [
        "none",
        "synced",
        "error"
      ]
    },
    "calendar_error": {
      "type": "string"
    }
  },
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  },
  "name": "Subscription",
  "required": []
}