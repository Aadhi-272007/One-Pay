{
  "title": "Template",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "merchant": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string"
    },
    "day_of_month": {
      "type": "number"
    },
    "billing_cycle": {
      "type": "string",
      "enum": [
        "weekly",
        "monthly",
        "quarterly",
        "annual"
      ]
    },
    "payment_method": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "bill_id": {
      "type": "string"
    },
    "last_logged_month": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  },
  "name": "Template",
  "required": []
}