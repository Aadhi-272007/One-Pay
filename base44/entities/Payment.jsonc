{
  "title": "Payment",
  "type": "object",
  "properties": {
    "bill_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "merchant": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string"
    },
    "paid_date": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "settled",
        "failed"
      ]
    },
    "reference": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "bill",
        "manual",
        "template",
        "gmail",
        "upi"
      ]
    },
    "notes": {
      "type": "string"
    },
    "upi_ref": {
      "type": "string"
    },
    "upi_vpa": {
      "type": "string"
    },
    "attachment_uri": {
      "type": "string"
    },
    "refund_amount": {
      "type": "number"
    },
    "refund_date": {
      "type": "string"
    }
  },
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  },
  "name": "Payment",
  "required": []
}